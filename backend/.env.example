# Copy to backend/.env. Never commit the real .env.

# Development: DEBUG=true allows a local SECRET_KEY and localhost.
DEBUG=true
# Production: set a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins of the advisors' panel.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The agency's time zone: office hours and the bot's clock use it.
BUSINESS_TIMEZONE=America/Cancun

# Telegram token from @BotFather. A value saved in the panel takes precedence.
TELEGRAM_TOKEN=

# The language model: OpenAI, or any OpenAI-compatible endpoint.
#   OpenAI:  leave AI_BASE_URL empty, AI_API_KEY=sk-..., AI_MODEL=gpt-4o-mini
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1, no key, AI_MODEL=qwen2.5:7b
#   Groq:    AI_BASE_URL=https://api.groq.com/openai/v1, AI_API_KEY=gsk_..., AI_MODEL=llama-3.3-70b-versatile
#   Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, AI_API_KEY=..., AI_MODEL=gemini-2.5-flash
# Model names change over time: check the provider's current list.
# A key saved in the panel takes precedence over AI_API_KEY (OPENAI_API_KEY also works).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Reads the photo of the ID. Needs a model with vision; without one, IDs are accepted unverified.
AI_VISION_MODEL=gpt-4o-mini
# Chat or group that receives a summary of every complete prospect (the bot must be a member).
ADVISOR_CHAT_ID=
# Aviso de privacidad the bot shares before asking for personal data.
PRIVACY_NOTICE_URL=

# Panel sessions last this many seconds.
PANEL_TOKEN_MAX_AGE=43200

# Public web chat demo at /. On by default only with DEBUG=true.
WEB_CHAT_ENABLED=
WEB_CHAT_MAX_MESSAGES=30
WEB_CHAT_MAX_PER_IP_PER_HOUR=60
WEB_CHAT_DAILY_LIMIT=1000
WEB_CHAT_RETENTION_HOURS=24
# Proxies in front of the app (1 on Render, Fly or Railway), to rate-limit by the visitor's address.
WEB_CHAT_PROXY_HOPS=0
